# Copy this to .env and fill in the value. .env is gitignored and never committed.
#
#   cp .env.example .env
#   # edit .env, then load it into your shell:
#   set -a; source .env; set +a
#
# There is no dotenv loader in the Go code — it reads plain environment
# variables — so the file has to be sourced as above (or exported by hand).

# Google Gemini API key. Free, no payment method required:
#   https://aistudio.google.com/apikey
#
# Needed ONLY for --provider gemini, i.e. live model calls and the one-time
# fixture recording run:
#   go run ./cmd/disco eval --provider gemini --record
#
# NOT needed for anything else. `go test ./...` and every command using the
# default --provider fixture run entirely offline with no key.
GEMINI_API_KEY=
